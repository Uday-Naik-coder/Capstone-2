# Environment for docker-compose deployment (and local reference).
# Copy to .env and fill in real values. NEVER commit the real .env.
#   cp .env.example .env

# REQUIRED: secret used to sign JWTs. Generate with:  openssl rand -hex 32
JWT_SECRET=

# Access-token lifetime (e.g. 15m, 24h, 7d).
JWT_EXPIRES_IN=7d

# Comma-separated allowed CORS origins, or * for any (dev only).
CORS_ORIGIN=*

# Optional: Google OAuth client id. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Optional break-glass admin login (works even when Mongo has no users).
# Used by the backend only if AUTH_ADMIN_EMAIL / AUTH_ADMIN_PASSWORD are set.
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=

# true (default) = require login for POST /api/predict. false = open.
AUTH_REQUIRED=true

# Frontend build-time value: Google OAuth client id baked into the SPA bundle.
# Leave blank to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=

# Host port the frontend (nginx) is published on -> http://localhost:<HTTP_PORT>
HTTP_PORT=8080

# Tag applied to built images (CI overrides with the build number / git sha).
IMAGE_TAG=latest