# ---------------------------------------------------------------------------
# Docker build context exclusions.
# Keeps the build context small and avoids leaking local-only / host-specific
# files into images. NOTE: src/serving/model is intentionally NOT excluded —
# the ML Dockerfile COPYs the bundled model from there.
# ---------------------------------------------------------------------------

# Python
.venv/
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ipynb_checkpoints/

# Node
**/node_modules/
npm-debug.log*
**/coverage/
**/dist/

# Version control / OS noise
.git/
.gitignore
.kilo/
.DS_Store

# Secrets (never bake into the image)
.env
**/.env

# Large data & notebooks (not needed at build/runtime)
ML Model/data/
ML Model/notebooks/
ML Model/mlruns/
ML Model/artifacts/

# Local dev / misc
*.log