# ---- Backend environment configuration ----
# Copy this file to `.env` and fill in values. Never commit the real `.env`.

# Node
NODE_ENV=development
PORT=4000

# MongoDB (leave empty to run without persistence; predictions still work)
MONGODB_URI=mongodb://127.0.0.1:27017/telco_churn

# Python ML service (services/ml FastAPI app)
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=5000

# CORS (use * for local dev; set to your frontend origin in production)
CORS_ORIGIN=*

# ---- Auth (Phase 5) ----
# JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty in development, a random per-process secret is used (tokens do not
# survive a restart). JWT_SECRET MUST be set in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth client ID (leave empty to disable Google login; /api/auth/google
# then returns 503). From Google Cloud Console -> Credentials -> OAuth client.
GOOGLE_CLIENT_ID=

# Auth enforcement. true = /api/predict requires a Bearer JWT (default).
AUTH_REQUIRED=true

# Optional email/password login that works without a database (local/demo).
# Leave empty to disable. Use a strong password outside local dev.
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=